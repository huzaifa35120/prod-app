# Copy this file to `.env` and fill in the two values from your Supabase project.
# Project Settings -> API  (Supabase dashboard)
#
# The EXPO_PUBLIC_ prefix is required: it is what makes the value visible to the
# app at build time. The anon key is safe to ship in a client — Row Level
# Security is what protects your data, and it is enabled on every table.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
